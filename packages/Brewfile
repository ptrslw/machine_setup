brew "googletest"

# Node — needed for Claude Code and other npm-distributed CLIs
brew "node"

# Containers
brew "colima"
brew "docker"
brew "docker-compose"

# Fonts
cask "font-jetbrains-mono"

# GUI apps (workflow core)
# Stable WezTerm. Conflicts with cask wezterm@nightly — bootstrap removes
# nightly before brew bundle if both would clash.
cask "wezterm"
cask "visual-studio-code"
cask "cursor"
cask "clion"            # C++ IDE
