# Brewfile — macOS *core* packages. Installed by `bootstrap.sh packages`.
# Personal / optional casks and formulas: packages/Brewfile.optional
#   brew bundle --file packages/Brewfile.optional
#
# Add a core tool: append here, re-run bootstrap (or brew bundle).
# Retire a tool: delete its line, then
#   brew bundle cleanup --file packages/Brewfile

# Core CLI
brew "git"
