# Template for ~/.secrets.env — variable NAMES only. Never put real values here.
#
# This repo is public. Real credentials live only in ~/.secrets.env on each
# machine (mode 600 = owner read/write, no group/other access):
#
#   cp shell/secrets.env.example ~/.secrets.env
#   chmod 600 ~/.secrets.env
#   $EDITOR ~/.secrets.env
#
# Loaded by shell/common.sh (set -a / source / set +a). Gitignored.
# `bootstrap.sh doctor` checks that the file exists and is mode 600.
# Full policy: docs/secrets.md
#
# Only fill keys you actually use. Empty exports are fine.

# -----------------------------------------------------------------------------
# Required for the primary agent pathway (Claude Code)
# -----------------------------------------------------------------------------
export ANTHROPIC_API_KEY=       # console.anthropic.com → API Keys

# -----------------------------------------------------------------------------
# Optional — exploratory agents (only if you run ./bootstrap.sh codex|opencode)
# -----------------------------------------------------------------------------
export OPENAI_API_KEY=          # platform.openai.com → API Keys (Codex default provider)
export DEEPSEEK_API_KEY=        # platform.deepseek.com → API Keys (Codex / OpenCode)

# -----------------------------------------------------------------------------
# Optional — personal automation / side projects (not part of machine_setup itself)
# Uncomment or fill only if a project on this machine needs them.
# -----------------------------------------------------------------------------
# export SLACK_APP_TOKEN=       # api.slack.com/apps/<app> → App-Level Tokens
# export SLACK_BOT_TOKEN=       # api.slack.com/apps/<app> → Bot User OAuth Token
# export SLACK_ALLOWED_USER_IDS=  # comma-separated Slack member IDs
# export GOOGLE_API_KEY=        # console.cloud.google.com → Credentials
# export GOOGLE_CSE_ID=         # programmablesearchengine.google.com
# export GMAIL_APP_ACCOUNT=     # myaccount.google.com/apppasswords
# export GMAIL_APP_PASSWORD=
# export DEEPGRAM_API_KEY=      # console.deepgram.com
# export BRAVE_API_KEY=         # brave.com/search/api
